# UPHI Environment Variables Template
# Copy this file to .env and fill in the actual values.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Stitch AI API Key (Used in run-stitch.sh)
STITCH_API_KEY=your_stitch_api_key_here

# Google Gemini API Key (Used in uphi-backend)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail App Password (Used in uphi-backend for notifications)
MAIL_PASSWORD=your_gmail_app_password_here

# JWT Secret Key (Min 64 characters suggested)
JWT_SECRET=your_jwt_secret_key_here
